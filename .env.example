# Local development examples. Settings and validation are defined in gateway.config.
GATEWAY_PROCESS_NAME=gateway-api
GATEWAY_ENVIRONMENT=local
GATEWAY_LOG_LEVEL=INFO
GATEWAY_LOG_FORMAT=text

GATEWAY_DATABASE_URL=postgresql+psycopg://gateway_local:gateway_local@localhost:5432/gateway
GATEWAY_REDIS_URL=redis://localhost:6379/0

GATEWAY_CELERY_BROKER_URL=redis://localhost:6379/1
GATEWAY_WORKER_QUEUE_NAME=gateway-usage
GATEWAY_WORKER_CONCURRENCY=2

GATEWAY_STORAGE_BACKEND=local
GATEWAY_STORAGE_ROOT=.local/storage
