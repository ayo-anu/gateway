# Local development examples. Settings and validation are defined in aegis.config.
AEGIS_PROCESS_NAME=gateway-api
AEGIS_ENVIRONMENT=local
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_FORMAT=text

AEGIS_DATABASE_URL=postgresql+psycopg://aegis_local:aegis_local@localhost:5432/aegis
AEGIS_REDIS_URL=redis://localhost:6379/0

AEGIS_CELERY_BROKER_URL=redis://localhost:6379/1
AEGIS_WORKER_QUEUE_NAME=aegis-usage
AEGIS_WORKER_CONCURRENCY=2

AEGIS_STORAGE_BACKEND=local
AEGIS_STORAGE_ROOT=.local/storage
